# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to GitHub.

# Supabase client-side values for Vite
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# Supabase server-side values
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_ID=your-project-ref-id
SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin app values
ADMIN_PASSWORD=your-admin-password
ADMIN_SESSION_SECRET=your-random-32-char-secret-key